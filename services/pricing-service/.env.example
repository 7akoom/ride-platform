SERVICE_NAME=pricing-service
ENVIRONMENT=development

GRPC_ADDRESS=:50057
METRICS_ADDRESS=:9097

DATABASE_URL=postgres://ride_platform:password@localhost:5437/pricing_service?sslmode=disable

LOCATION_SERVICE_ADDRESS=localhost:50054

# Self-hosted OSRM. See infrastructure/osrm/README.md for one-time setup.
# If unreachable, pricing falls back to a Haversine estimate.
OSRM_BASE_URL=http://localhost:5000

NATS_URL=nats://127.0.0.1:4222
NATS_PUBLISH_TIMEOUT=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_DRAIN_TIMEOUT=10s

OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE_DURATION=30s
OUTBOX_BATCH_SIZE=10
OUTBOX_INITIAL_RETRY_DELAY=1s
OUTBOX_MAX_RETRY_DELAY=1m
