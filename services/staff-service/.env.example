SERVICE_NAME=staff-service
ENVIRONMENT=development

GRPC_ADDRESS=:50061
METRICS_ADDRESS=:9101

DATABASE_URL=postgres://staff_user:change-me@localhost:5442/staff_db?sslmode=disable

# identity-service, asked (with the staff member's own access token) which
# email addresses it verified, when a staff member accepts an invitation.
IDENTITY_SERVICE_ADDRESS=localhost:50051

# The first owner. When there is no staff member at all, this address is
# invited as owner at startup; sign in with it (email OTP) and call
# POST /v1/staff/me:accept. Ignored once any staff member exists.
STAFF_BOOTSTRAP_OWNER_EMAIL=

# Verifies access tokens issued by identity-service. Copy the PUBLIC key
# from identity-service's .local/keys/access_token_public.pem here.
ACCESS_TOKEN_PUBLIC_KEY_PATH=.local/keys/access_token_public.pem
ACCESS_TOKEN_ISSUER=ride-identity
ACCESS_TOKEN_AUDIENCE=ride-platform
ACCESS_TOKEN_KEY_ID=identity-dev-1

# Shared secret for service-to-service calls. Every other service uses it to
# ask AuthorizeStaffAction before an admin RPC runs. Must be IDENTICAL across
# every service; generate a real one per deployment (openssl rand -hex 32).
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me

RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40
