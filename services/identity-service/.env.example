APP_ENV=development
GRPC_ADDRESS=:50051

DATABASE_URL=postgres://identity_user:change-me@localhost:5433/identity_db?sslmode=disable
VALKEY_ADDRESS=127.0.0.1:6380
VALKEY_PASSWORD=

OTP_HASH_SECRET=
OTP_CHALLENGE_TTL=5m

OTP_BRAND_NAME=Ride
OTP_PROVIDER_HTTP_TIMEOUT=10s

# Global SMS routing.
# SMS_DEFAULT_PROVIDER should be a provider capable of international delivery.
SMS_DEFAULT_PROVIDER=

# Optional prefix-based regional overrides.
# Format: +country_or_network_prefix=provider
# Multiple routes are separated by commas.
SMS_ROUTES=+964=bulksmsiraq

# Telnyx global SMS provider configuration.
# Use "telnyx" as SMS_DEFAULT_PROVIDER when Telnyx is enabled.
TELNYX_ENDPOINT=https://api.telnyx.com/v2/messages
TELNYX_API_KEY=
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=

# WhatsApp routing.
# Leave both values empty to disable WhatsApp delivery.
# WHATSAPP_DEFAULT_PROVIDER is the global provider used when no route matches.
WHATSAPP_DEFAULT_PROVIDER=

# Optional prefix-based regional WhatsApp overrides.
# Format: +country_or_network_prefix=provider
# Multiple routes are separated by commas.
WHATSAPP_ROUTES=

# Meta WhatsApp Cloud API provider configuration.
# META_WHATSAPP_ENDPOINT must be the full Graph API messages endpoint
# for the configured WhatsApp phone number ID.
META_WHATSAPP_ENDPOINT=
META_WHATSAPP_ACCESS_TOKEN=

# English authentication template is required when Meta is enabled.
META_WHATSAPP_TEMPLATE_EN_NAME=
META_WHATSAPP_TEMPLATE_EN_LANGUAGE=en_US

# Optional Arabic authentication template.
# If omitted, the English template is used as fallback.
META_WHATSAPP_TEMPLATE_AR_NAME=
META_WHATSAPP_TEMPLATE_AR_LANGUAGE=ar

# Optional Kurdish authentication template.
# Leave the language empty until a supported Meta template language code
# has been explicitly configured.
# If omitted, the English template is used as fallback.
META_WHATSAPP_TEMPLATE_KU_NAME=
META_WHATSAPP_TEMPLATE_KU_LANGUAGE=

# BulkSMSIraq regional provider configuration.
BULKSMSIRAQ_ENDPOINT=
BULKSMSIRAQ_API_KEY=
BULKSMSIRAQ_SENDER_ID=

# Email provider.
EMAIL_PROVIDER=resend
RESEND_ENDPOINT=https://api.resend.com/emails
RESEND_API_KEY=
RESEND_FROM="Ride <no-reply@your-domain.com>"

OTP_REQUEST_COOLDOWN=60s
OTP_REQUEST_WINDOW=15m
OTP_REQUEST_MAX_REQUESTS=5
OTP_REQUEST_SOURCE_WINDOW=10m
OTP_REQUEST_SOURCE_MAX_REQUESTS=30

# Access token signing.
# ACCESS_TOKEN_PRIVATE_KEY_PATH is the active private signing key.
# ACCESS_TOKEN_KEY_ID identifies the active signing key and is written
# into the JWT "kid" header.
ACCESS_TOKEN_PRIVATE_KEY_PATH=.local/keys/access_token_private.pem
ACCESS_TOKEN_PUBLIC_KEY_PATH=.local/keys/access_token_public.pem

# Optional verification keyring for signing-key rotation.
#
# When empty, the service falls back to:
# ACCESS_TOKEN_PUBLIC_KEY_PATH + ACCESS_TOKEN_KEY_ID
#
# During key rotation, keep both the new active public key and the
# previous public key in this keyring for at least the maximum access
# token lifetime, plus a safe deployment and clock-skew margin.
#
# Example:
# ACCESS_TOKEN_KEY_ID=identity-dev-2
# ACCESS_TOKEN_PRIVATE_KEY_PATH=.local/keys/access_token_private_2.pem
# ACCESS_TOKEN_VERIFICATION_KEYS=[{"kid":"identity-dev-2","public_key_path":".local/keys/access_token_public_2.pem"},{"kid":"identity-dev-1","public_key_path":".local/keys/access_token_public.pem"}]
#
# After all tokens signed by identity-dev-1 have expired, remove the
# old key from ACCESS_TOKEN_VERIFICATION_KEYS.
ACCESS_TOKEN_VERIFICATION_KEYS=

ACCESS_TOKEN_ISSUER=ride-identity
ACCESS_TOKEN_AUDIENCE=ride-platform
ACCESS_TOKEN_KEY_ID=identity-dev-1
ACCESS_TOKEN_TTL=15m

SESSION_TTL=720h
REFRESH_TOKEN_TTL=696h

CLEANUP_INTERVAL=1h
OTP_REQUEST_EVENT_RETENTION=24h
OTP_CHALLENGE_RETENTION=24h
AUTH_SESSION_RETENTION=720h