APP_ENV=development
GRPC_ADDRESS=:50051

DATABASE_URL=postgres://identity_user:change-me@localhost:5433/identity_db?sslmode=disable
VALKEY_ADDRESS=127.0.0.1:6380
VALKEY_PASSWORD=

OTP_HASH_SECRET=
OTP_CHALLENGE_TTL=5m

OTP_REQUEST_COOLDOWN=60s
OTP_REQUEST_WINDOW=15m
OTP_REQUEST_MAX_REQUESTS=5

ACCESS_TOKEN_PRIVATE_KEY_PATH=.local/keys/access_token_private.pem
ACCESS_TOKEN_PUBLIC_KEY_PATH=.local/keys/access_token_public.pem
ACCESS_TOKEN_ISSUER=ride-identity
ACCESS_TOKEN_AUDIENCE=ride-platform
ACCESS_TOKEN_KEY_ID=identity-dev-1
ACCESS_TOKEN_TTL=15m

SESSION_TTL=720h
REFRESH_TOKEN_TTL=696h

CLEANUP_INTERVAL=1h
OTP_REQUEST_EVENT_RETENTION=24h
OTP_CHALLENGE_RETENTION=24h
AUTH_SESSION_RETENTION=720h