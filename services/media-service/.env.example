SERVICE_NAME=media-service
ENVIRONMENT=development

GRPC_ADDRESS=:50062
METRICS_ADDRESS=:9102

DATABASE_URL=postgres://media_user:change-me@localhost:5443/media_db?sslmode=disable

# The S3-compatible object store (SeaweedFS in docker compose).
# S3_ENDPOINT is how this service reaches it. S3_PUBLIC_ENDPOINT is the
# address the apps use; presigned upload/download URLs carry it and the
# signature covers it, so it must be exactly what the phone connects to
# (in production: the public HTTPS address of the object store, behind a
# proxy that passes the Host header unchanged).
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=ride-media
# Must match the SeaweedFS identity (S3_ACCESS_KEY / S3_SECRET_KEY in the
# compose .env). Generate real ones per deployment.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# How long an upload URL accepts the bytes, how long a download URL works,
# and when an upload never completed is dropped (longer than the upload URL).
UPLOAD_URL_TTL=10m
DOWNLOAD_URL_TTL=5m
PENDING_UPLOAD_TTL=30m
# Uploads one person may have started and not completed at once.
MAX_PENDING_UPLOADS_PER_OWNER=20
# Files checked at the same time; each image check can take a few hundred MB.
MAX_CONCURRENT_INSPECTIONS=2

# staff-service, asked before a staff member reads a file that is not theirs
# (permission media.read).
STAFF_SERVICE_ADDRESS=localhost:50061

# Verifies access tokens issued by identity-service. Copy the PUBLIC key
# from identity-service's .local/keys/access_token_public.pem here.
ACCESS_TOKEN_PUBLIC_KEY_PATH=.local/keys/access_token_public.pem
ACCESS_TOKEN_ISSUER=ride-identity
ACCESS_TOKEN_AUDIENCE=ride-platform
ACCESS_TOKEN_KEY_ID=identity-dev-1

# Shared secret for service-to-service calls (HoldMedia / ReleaseMedia, and
# this service asking staff-service). Must be IDENTICAL across every
# service; generate a real one per deployment (openssl rand -hex 32).
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me

RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40
