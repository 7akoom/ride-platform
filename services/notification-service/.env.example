SERVICE_NAME=notification-service
ENVIRONMENT=development

GRPC_ADDRESS=:50059
METRICS_ADDRESS=:9099

DATABASE_URL=postgres://ride_platform:password@localhost:5439/notification_service?sslmode=disable

# Optional. Path to a Firebase service-account JSON key for push.
# Leave empty to run without push — in-app notifications still work.
# Get one at: Firebase console > Project settings > Service accounts.
FCM_CREDENTIALS_FILE=

# Peers this service calls to enrich events before rendering a
# notification (rider ID, driver name/vehicle, dropoff location).
TRIP_SERVICE_ADDRESS=localhost:50055
DRIVER_SERVICE_ADDRESS=localhost:50053

NATS_URL=nats://localhost:4222
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_DRAIN_TIMEOUT=5s

# Verifies access tokens issued by identity-service. Copy the PUBLIC key
# from identity-service's .local/keys/access_token_public.pem here — never
# copy the private key. Issuer/audience/key ID must match identity-service's
# ACCESS_TOKEN_ISSUER/ACCESS_TOKEN_AUDIENCE/ACCESS_TOKEN_KEY_ID.
ACCESS_TOKEN_PUBLIC_KEY_PATH=.local/keys/access_token_public.pem
ACCESS_TOKEN_ISSUER=ride-identity
ACCESS_TOKEN_AUDIENCE=ride-platform
ACCESS_TOKEN_KEY_ID=identity-dev-1

# Shared secret for service-to-service calls (dispatch/pricing calling
# their peers, notification's background NATS consumer calling
# trip/driver). Must be IDENTICAL across every service in a deployment.
# The value below is a placeholder for local dev only — generate a real
# random secret per deployment (e.g. `openssl rand -hex 32`) and set the
# same value in every service's environment.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me

# Per-caller (per authenticated identity) token-bucket rate limit.
# Defaults are generous for a single mobile-app client under normal
# use; tight enough to stop a runaway retry loop or a naive script.
# Internal service-to-service calls and the health check are exempt.
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40

# SOS operator alerts. When a rider or driver presses SOS, a human at the
# operating company must be told out of band, not only the person who
# pressed the button. Configure at least one channel; with none, every SOS
# is logged as an ERROR saying nobody was alerted.
#
# SMS: comma-separated numbers, digits only (a leading + is dropped). They
# are texted through the BulkSMSIraq gateway, using the same BULKSMSIRAQ_*
# values identity-service uses. All three gateway values are required as
# soon as SOS_OPERATOR_PHONES is set.
SOS_OPERATOR_PHONES=
BULKSMSIRAQ_ENDPOINT=
BULKSMSIRAQ_API_KEY=
BULKSMSIRAQ_SENDER_ID=

# Webhook: a JSON POST per alert to any chat/paging bridge. If a secret is
# set the body is signed: X-Signature-256: sha256=<hex HMAC-SHA256 of body>.
SOS_WEBHOOK_URL=
SOS_WEBHOOK_SECRET=

# A failed alert is retried every SOS_ALERT_RETRY_INTERVAL until
# SOS_ALERT_GIVE_UP_AFTER has passed since the SOS, then an error is logged.
SOS_ALERT_TIMEOUT=10s
SOS_ALERT_RETRY_INTERVAL=15s
SOS_ALERT_GIVE_UP_AFTER=30m
