SERVICE_NAME=notification-service
ENVIRONMENT=development

GRPC_ADDRESS=:50059
METRICS_ADDRESS=:9099

DATABASE_URL=postgres://ride_platform:password@localhost:5439/notification_service?sslmode=disable

# Optional. Path to a Firebase service-account JSON key for push.
# Leave empty to run without push — in-app notifications still work.
# Get one at: Firebase console > Project settings > Service accounts.
FCM_CREDENTIALS_FILE=
