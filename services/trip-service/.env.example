SERVICE_NAME=trip-service
ENVIRONMENT=development

GRPC_ADDRESS=:50055
METRICS_ADDRESS=:9095

DATABASE_URL=postgres://ride_platform:password@localhost:5436/trip_service?sslmode=disable

NATS_URL=nats://127.0.0.1:4222
NATS_PUBLISH_TIMEOUT=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_DRAIN_TIMEOUT=10s

OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE_DURATION=30s
OUTBOX_BATCH_SIZE=10
OUTBOX_INITIAL_RETRY_DELAY=1s
OUTBOX_MAX_RETRY_DELAY=1m

# Verifies access tokens issued by identity-service. Copy the PUBLIC key
# from identity-service's .local/keys/access_token_public.pem here — never
# copy the private key. Issuer/audience/key ID must match identity-service's
# ACCESS_TOKEN_ISSUER/ACCESS_TOKEN_AUDIENCE/ACCESS_TOKEN_KEY_ID.
ACCESS_TOKEN_PUBLIC_KEY_PATH=.local/keys/access_token_public.pem
ACCESS_TOKEN_ISSUER=ride-identity
ACCESS_TOKEN_AUDIENCE=ride-platform
ACCESS_TOKEN_KEY_ID=identity-dev-1

# Shared secret for service-to-service calls (dispatch/pricing calling
# their peers, notification's background NATS consumer calling
# trip/driver). Must be IDENTICAL across every service in a deployment.
# The value below is a placeholder for local dev only — generate a real
# random secret per deployment (e.g. `openssl rand -hex 32`) and set the
# same value in every service's environment.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me

# Called before accepting any trip request, to check the pickup point
# is inside an active service zone.
LOCATION_SERVICE_ADDRESS=localhost:50054

# Per-caller (per authenticated identity) token-bucket rate limit.
# Defaults are generous for a single mobile-app client under normal
# use; tight enough to stop a runaway retry loop or a naive script.
# Internal service-to-service calls and the health check are exempt.
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40

# Ownership checks resolve the caller's identity to a rider or driver
# profile through these services.
RIDER_SERVICE_ADDRESS=localhost:50052
DRIVER_SERVICE_ADDRESS=localhost:50053
