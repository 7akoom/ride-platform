SERVICE_NAME=trip-service
ENVIRONMENT=development

GRPC_ADDRESS=:50055
METRICS_ADDRESS=:9095

DATABASE_URL=postgres://ride_platform:password@localhost:5436/trip_service?sslmode=disable

NATS_URL=nats://127.0.0.1:4222
NATS_PUBLISH_TIMEOUT=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_DRAIN_TIMEOUT=10s

OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE_DURATION=30s
OUTBOX_BATCH_SIZE=10
OUTBOX_INITIAL_RETRY_DELAY=1s
OUTBOX_MAX_RETRY_DELAY=1m
