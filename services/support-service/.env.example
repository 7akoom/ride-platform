SERVICE_NAME=support-service
ENVIRONMENT=development

GRPC_ADDRESS=:50063
METRICS_ADDRESS=:9103

DATABASE_URL=postgres://ride_platform:password@localhost:5444/support_service?sslmode=disable

NATS_URL=nats://127.0.0.1:4222
NATS_PUBLISH_TIMEOUT=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_DRAIN_TIMEOUT=10s

OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE_DURATION=30s
OUTBOX_BATCH_SIZE=10
OUTBOX_INITIAL_RETRY_DELAY=1s
OUTBOX_MAX_RETRY_DELAY=1m

# Verifies access tokens issued by identity-service (copy its PUBLIC key).
ACCESS_TOKEN_PUBLIC_KEY_PATH=.local/keys/access_token_public.pem
ACCESS_TOKEN_ISSUER=ride-identity
ACCESS_TOKEN_AUDIENCE=ride-platform
ACCESS_TOKEN_KEY_ID=identity-dev-1

# The services the support desk reads from and acts through, as a service.
STAFF_SERVICE_ADDRESS=localhost:50061
MEDIA_SERVICE_ADDRESS=localhost:50062
TRIP_SERVICE_ADDRESS=localhost:50055
RIDER_SERVICE_ADDRESS=localhost:50052
DRIVER_SERVICE_ADDRESS=localhost:50053
WALLET_SERVICE_ADDRESS=localhost:50058
IDENTITY_SERVICE_ADDRESS=localhost:50051

# Money one ticket may move (refunds, fee waivers, wallet credits, in the
# instance's currency) before a second staff member with support.approve
# has to agree. 0: every money action needs approval.
SUPPORT_REFUND_LIMIT=25000
# Open tickets one person may have as a rider (and again as a driver).
SUPPORT_MAX_OPEN_TICKETS=10
# How old a trip may be for a ticket about it.
SUPPORT_TRIP_MAX_AGE=720h
# How often actions a service did not answer are retried, and suspensions
# whose time is up are lifted.
SUPPORT_WORKER_INTERVAL=15s

# Shared secret for service-to-service calls; identical on every service.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me

RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40
