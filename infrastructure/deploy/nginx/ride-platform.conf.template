# Ride Platform behind the host's nginx: the API and the file store.
# Made by scripts/deploy/nginx-site.sh from this template; certbot adds TLS.
#
# The real client address: with Cloudflare in front, the host's
# cloudflare-real-ip.conf turns $remote_addr into the visitor's IP. It is
# REPLACED (not appended) in X-Forwarded-For, so a client cannot plant an
# address; identity-service trusts it only from the Docker network
# (TRUSTED_PROXY_CIDRS).

server {
    listen 80;
    listen [::]:80;
    server_name __API_DOMAIN__;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:__GATEWAY_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name __FILES_DOMAIN__;

    # Uploads go straight to the file store with a signed URL; the signature
    # covers the Host, so it is passed unchanged.
    client_max_body_size 30m;
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://127.0.0.1:__FILES_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
